# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` ke Git.

# Port server (default: 3000)
PORT=3000

# Token untuk halaman admin (/admin.html) — wajib diganti dengan string acak yang panjang!
# Contoh membuatnya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=ganti-dengan-token-acak-minimal-32-karakter

# Nomor WhatsApp admin untuk notifikasi pesanan (format: kode negara tanpa +, tanpa spasi)
# Contoh Indonesia: 6281234567890
ADMIN_WHATSAPP=6281234567890

# Nama toko yang tampil di website
SHOP_NAME=Dimsum Enak

# Alamat pickup (ditampilkan saat customer memilih metode Pickup)
PICKUP_ADDRESS=Jl. Contoh No. 123, Jakarta Selatan

# Folder database SQLite (default: ./data)
# DATA_DIR=./data
