# Jangan jalankan lifecycle scripts (install/postinstall) saat npm install/ci.
#
# Alasan: better-sqlite3 v13 menyertakan prebuilt binary langsung di paket npm
# (folder prebuilds/) dan TIDAK membutuhkan compile. Namun karena ia juga
# menyertakan file binding.gyp, npm secara otomatis mencoba menjalankan
# "node-gyp rebuild" saat install — yang GAGAL di environment build seperti
# Railway (tidak ada compiler / tidak bisa download Node headers).
#
# Semua dependency project ini (express, dotenv, better-sqlite3 v13) tidak
# membutuhkan install script, jadi aman untuk diabaikan.
# Jika suatu saat menambah dependency yang BUTUH postinstall script,
# baris ini harus ditinjau ulang.
ignore-scripts=true
